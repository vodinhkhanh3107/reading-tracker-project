{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seeds/index.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/config/database.ts",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d src/config/database.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/config/database.ts",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d src/config/database.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "mysql2": "^3.24.4",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
